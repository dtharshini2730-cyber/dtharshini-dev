<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bg-thirukkural" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#091c1a" />
      <stop offset="100%" stop-color="#070a10" />
    </linearGradient>
    <linearGradient id="glow-thirukkural" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#00e5ff" stop-opacity="0.2" />
    </linearGradient>
    <pattern id="grid-thirukkural" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="800" height="480" fill="url(#bg-thirukkural)" />
  <rect width="800" height="480" fill="url(#grid-thirukkural)" />
  
  <!-- Cyber Geometric Accents -->
  <circle cx="650" cy="120" r="180" fill="#2dd4bf" opacity="0.08" filter="blur(40px)" />
  <circle cx="150" cy="380" r="140" fill="#00e5ff" opacity="0.06" filter="blur(30px)" />
  
  <rect x="40" y="40" width="720" height="400" rx="16" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
  
  <!-- Top decorative bar -->
  <circle cx="70" cy="70" r="5" fill="#ef4444" opacity="0.8" />
  <circle cx="90" cy="70" r="5" fill="#eab308" opacity="0.8" />
  <circle cx="110" cy="70" r="5" fill="#22c55e" opacity="0.8" />
  <text x="140" y="74" fill="#64748b" font-family="monospace" font-size="12">MODULE // THIRUKKURAL</text>
  
  <!-- Center graphic badge -->
  <g transform="translate(400, 210)">
    <circle cx="0" cy="0" r="64" fill="rgba(0,0,0,0.5)" stroke="#2dd4bf" stroke-width="2" stroke-dasharray="8 4" />
    <circle cx="0" cy="0" r="50" fill="rgba(255,255,255,0.03)" />
    <text x="0" y="16" text-anchor="middle" font-size="44">📜</text>
  </g>
  
  <!-- Title and info -->
  <text x="400" y="325" text-anchor="middle" fill="#f8fafc" font-family="sans-serif" font-weight="700" font-size="28" letter-spacing="1">Thirukkural App</text>
  <text x="400" y="360" text-anchor="middle" fill="#2dd4bf" font-family="monospace" font-size="14" letter-spacing="2">BILINGUAL LITERATURE</text>
  <text x="400" y="400" text-anchor="middle" fill="#64748b" font-family="sans-serif" font-size="12">[ PREVIEW PLACEHOLDER • READY FOR SCREENSHOT ]</text>
</svg>